# Example only: adapt domain, paths, certificate and PHP-FPM socket.
server {
    listen 80;
    server_name tour.inborgoliving.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name tour.inborgoliving.com;
    root /var/www/html/public;
    index index.php;
    ssl_certificate /etc/letsencrypt/live/tour.inborgoliving.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/tour.inborgoliving.com/privkey.pem; # managed by Certbot
    client_max_body_size 32m;

    location ~ /\. { deny all; }
    location = /sw.js { add_header Cache-Control "no-cache"; try_files $uri =404; }
    location /api/ { rewrite ^ /api/index.php last; }
    location = /api/index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/api/index.php;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
    location /admin/ { rewrite ^ /admin/index.php last; }
    location = /admin { return 302 /admin/; }
    location = /admin/index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/admin/index.php;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
    location /route/ { rewrite ^/route/[a-z0-9-]+$ /index.php last; try_files $uri =404; }
    # Allow only media extensions in uploads; never pass them to PHP.
    location ^~ /uploads/ {
        if ($uri !~* "^/uploads/[a-f0-9]{32}\.(jpg|png|webp|mp3)$") { return 404; }
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }
    location / { try_files $uri $uri/ =404; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
    location ~ \.php$ { return 404; }
}
